<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    本仓库为公开项目，全部依赖都来自 nuget.org。
    这里显式固定还原源并配套包源映射（package source mapping），原因有二：
    1. 集中包管理（CPM）在机器上定义了多个包源时会报 NU1507；
    2. 固定单一还原源可让本仓库在任意机器（含 CI）上还原结果一致，
       不受开发者本机 NuGet 全局配置里的私有源影响。
    详见 https://aka.ms/nuget-package-source-mapping
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
