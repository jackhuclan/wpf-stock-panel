<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    控件样式库（spec §5.3 / §5.4）。Task 6 里散落在 MainWindow 的控件样式收敛于此，
    供 Task 8 与 P1 的页面按名复用；主窗口只保留具名引用，不再自带样式。

    三条铁律：
    1) 命名按"控件是什么"（侧栏项 / 卡片 / 徽标 / 按钮），不按"用在哪"——否则换个页面就得改名；
    2) 颜色只引用 Themes/Tokens.axaml 的令牌键，一律 {DynamicResource}。{StaticResource}
       会在加载时把色值烤死，运行中切换主题就不会跟随（Review Focus 第 4 项）。
       缓动 SmoothEasing 与主题无关，用 {StaticResource} 取即可；
    3) 库里的具名样式必须有消费者，页面里也不得再留与具名样式重复的内联样式——
       否则库和页面各写一份，本文件就白建了。
    4) **外边距（Margin）不属于样式**：同一个控件在不同页面里占的地方并不一样，一律写在挂类的那一行上。
       控件自身的内边距（Padding）则属于它的形状（tile 的厚度、badge 的胖瘦），留在库里，
       使用处若确实要另定厚薄，也是在那一行上写——不要回到库里改，那会把别的页面的形状一起改掉。

    消费者一览（新页面挂这些类即可，不要再抄一份同样的样式）：
      nav-list   MainWindow 侧栏菜单            ghost   MainWindow 侧栏底部按钮
      card       MainWindow 指数条外框、取数失败态卡片、PlaceholderPage 内容卡
      badge      MainWindow 夹具角标、PlaceholderPage 核心/扩展域徽标
      badge.warning（修饰类，与 badge 同时挂）  MainWindow 夹具角标
      tile       MainWindow 指数条四个小格
      quote-value（含 .up / .down）  MainWindow 指数条的点位与涨跌幅

    本文件由 App.axaml 在 <FluentTheme /> **之后**引入，因此下面的 Setter 覆盖主题默认值。
  -->

  <!-- ===== 侧栏项 =====
       ListBoxItem 由 ListBox 在运行时生成，无法在 XAML 里逐个挂 Class，
       故用 ListBox.nav-list 限定作用域：凡是标了 nav-list 的列表都得到这套侧栏项外观。 -->
  <Style Selector="ListBox.nav-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8" />
    <!-- 关掉横向滚动条：长中文页名才会走 TextTrimming 省略，而不是把侧栏撑宽 -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}" />
    <!-- FluentTheme 默认给列表项留了最小高度，会把 19 项菜单撑得很长 -->
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <!-- 盖掉 FluentTheme 在 ContentPresenter 上自带的悬停/选中底色 -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource SmoothEasing}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ListBox.nav-list ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
  </Style>

  <!-- ===== 按钮 =====
       幽灵按钮：透明底、无边框、圆角 BtnRadius，悬停才升起一层 elevated 面。
       同样是盖 ContentPresenter 而不是 Button.Background——FluentTheme 的悬停底色加在模板内的
       ContentPresenter 上，只设 Button 的 Background 会被它压过去。
       外间距不在这里：侧栏底部的两个按钮贴边留 8px、彼此之间也留 8px（由两枚按钮各自的 4px 相加而来），
       都写在挂类的那一行上。中间那道缝不能留 0——两个按钮的悬停底色会在 `*,*` 的分界处贴在一起，
       看着像一个控件。 -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <!-- 缓动只挂在 Background 上：它在两套主题里都是 Transparent，切主题时不产生变化，
         因此按钮与其它元素一样是"同帧跟随"，不会出现只有按钮还在渐变的一瞬。 -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource SmoothEasing}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
  </Style>

  <!-- ===== 卡片 =====
       层次靠 1px 细边框而非阴影（spec §5.3：暗色下不用阴影）。外边距与内边距留给使用处，
       因为同一个卡片在不同页面里的留白并不一样。 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
  </Style>

  <!-- ===== 徽标 =====
       核心 / 扩展页的域徽标。底与描边抬一层，文字走 AccentBrush。
       消费者：P0 的 PlaceholderPage 直接挂 Classes="badge"；Task 8 与 P1 的页面同理。 -->
  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 徽标的"警示"变体（Classes="badge warning"）：底仍是 elevated，但描边与语义都换成 warning。
       文字改用 FgPrimaryBrush 而不是 WarningBrush，是**实测对比度**的选择（task-8-report §9，脚本
       task-8-shots/contrast.ps1）：warning 文字压在 elevated 底上，亮色主题只有 2.14:1（暗色 6.83:1），
       而 FgPrimary 压在同一个底上两套主题分别是 15.36:1 / 16.12:1。
       于是警示语义交给琥珀描边、可读性交给前景色，两者都不让步，且不新增任何令牌。
       消费者：MainWindow 的夹具角标（spec §5.2 的硬要求，必须看得清）。 -->
  <Style Selector="Border.badge.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.badge.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
  </Style>

  <!-- ===== 小面块 =====
       嵌在大面里的等分小格（侧栏指数条的四格就是它）。比卡片矮一级：用 elevated 底、不描边。 -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    <Setter Property="Padding" Value="6,5" />
  </Style>

  <!-- ===== 行情数值 =====
       点位 / 涨跌幅这类数字：一律等宽字形（spec §5.3 的"数字一律等宽"），方向由挂类的元素
       用 Classes.up / Classes.down 表达（数据侧给的是方向，不是颜色——颜色只在这里出现）。
       红涨绿跌用的是 bull / bear，**只用于价格与行情数值**，绝不做 UI 状态色
       （成功 / 失败 / 警告另有 accent / warning / danger）。
       两个方向类都为假即平盘，走中性色，于是"涨红跌绿"不会把平盘误标成涨。
       字号不在这里：同一个方向色在指数条（小字）与 P1 的行情表（大字）里大小不同。 -->
  <Style Selector="TextBlock.quote-value">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.quote-value.up">
    <Setter Property="Foreground" Value="{DynamicResource BullBrush}" />
  </Style>
  <Style Selector="TextBlock.quote-value.down">
    <Setter Property="Foreground" Value="{DynamicResource BearBrush}" />
  </Style>

</Styles>
