<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="using:Tsp.Desktop.ViewModels.Navigation"
        xmlns:pages="using:Tsp.Desktop.Views.Pages"
        xmlns:vm="using:Tsp.Desktop.ViewModels"
        x:Class="Tsp.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Tsp — A 股量化研究桌面工作台"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource BaseBrush}"
        FontFamily="{DynamicResource SansFontFamily}">

  <!--
    主窗口骨架（spec §5.4）：左侧栏（19 页菜单 + 底部设置入口与主题切换 + 指数条）+ 1px 分隔线 + 内容区。

    控件外观一律来自 Themes/Controls.axaml 的具名样式（nav-list / ghost / card / tile），本文件不再自带 <Window.Styles>。
    颜色只出现在令牌引用里，且必须用 {DynamicResource}——{StaticResource} 会把色值在加载时烤死，
    运行中切换主题就不会跟随（Review Focus 第 4 项）。
  -->

  <Grid ColumnDefinitions="220,1,*">

    <!-- 左侧栏 -->
    <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Background="{DynamicResource SurfaceBrush}">

      <!-- 19 页菜单。SelectedItem 两向绑定 SelectedMenuRoute：设置页不在 Menu 内，其选中态必然为空。 -->
      <ListBox Grid.Row="0"
               Classes="nav-list"
               ItemsSource="{Binding Menu}"
               SelectedItem="{Binding SelectedMenuRoute, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="nav:PageRoute">
            <!-- 长中文页名一律省略号收尾，不得把侧栏撑破 -->
            <TextBlock Text="{Binding Title}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!--
        侧栏底部入口。设置与明暗切换并排一行，而不是上下堆叠：底部区块因此保持 Task 6 的高度，
        19 项菜单在默认 1280x800 下仍然全部可见、不出现滚动条（堆叠会多占一行，把菜单顶出滚动条）。
      -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*">

        <!-- 设置页独立于 19 页表格（spec §5.6），由这里单独进入 -->
        <Button Grid.Column="0"
                Classes="ghost"
                Content="设置"
                Command="{Binding NavigateCommand}"
                CommandParameter="{Binding SettingsRoute}" />

        <!--
          明暗切换：本任务用来验证"运行中切主题同帧生效"的入口，不是最终设计。
          P1/P2 落地真实设置页（数据源 / AI / 页面管理 / 系统设置 …）后应把它并进去，
          不要在这里和设置页各留一个入口。
        -->
        <Button Grid.Column="1"
                Classes="ghost"
                Content="切换主题"
                Click="OnToggleThemeClick" />

      </Grid>

      <!--
        侧栏底部指数条：Task 8 把它接到 IndexQuotes 上（名称、点位、涨跌幅，涨用 BullBrush / 跌用 BearBrush）。
        此处先落到产品契约固定的四只核心指数与占位数值，把布局、令牌与等宽字体先钉死。
      -->
      <Border Grid.Row="2"
              Classes="card"
              Margin="8,2,8,8"
              Padding="6">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
          <Border Grid.Row="0" Grid.Column="0" Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Text="上证指数" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgSecondaryBrush}" />
              <TextBlock Text="—" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Text="深证成指" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgSecondaryBrush}" />
              <TextBlock Text="—" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Text="创业板指" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgSecondaryBrush}" />
              <TextBlock Text="—" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Text="科创综指" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgSecondaryBrush}" />
              <TextBlock Text="—" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

    </Grid>

    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

    <!--
      内容区。P0 只有占位页一种页面，所以这里直接挂占位页：路由切换（含 CurrentRoute 为 null 的空状态）
      由 PlaceholderPage 自己按 CurrentRoute 渲染。P1 有第二种页面时，这里换成按路由键分发的内容宿主。
    -->
    <pages:PlaceholderPage Grid.Column="2" />

  </Grid>

</Window>
