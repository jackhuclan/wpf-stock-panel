<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tsp.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Tsp.Desktop/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- 控件样式库必须排在 FluentTheme 之后，本项目的具名样式才会盖过主题默认值 -->
    <StyleInclude Source="avares://Tsp.Desktop/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
